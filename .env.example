# Frontend
# Leave empty to use same-origin via Vite proxy (dev) or same host in prod
# Set to full backend URL if frontend and backend are on different hosts, e.g. https://api.example.com
VITE_API_URL=

# Backend env is in server/.env.example -> copy it to server/.env
# Required: DATABASE_URL, GEMINI_API_KEY (Gemini 3.1 Flash Lite from https://aistudio.google.com/apikey)
# See server/.env.example for all backend vars
