{
  "name": "roadmap-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": {
    "name": "Rohit Arabale",
    "url": "https://github.com/rohit-arabale"
  },
  "homepage": "https://github.com/rohit-arabale/roadmap-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohit-arabale/roadmap-ai.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch server/src/index.ts",
    "dev:full": "docker compose up -d db && echo 'DB ready, run: bun run dev:server  &  bun run dev' ",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:push": "bunx --cwd server prisma db push",
    "clean": "rm -rf dist server/dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "chart.js": "^4.5.1",
    "framer-motion": "^13.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-intersection-observer": "^11.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
