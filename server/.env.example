# PostgreSQL - Docker compose provides this DB on 5433
# For local dev without Docker, set to your own Postgres, e.g. postgresql://user:pass@localhost:5432/roadmapai
DATABASE_URL="postgresql://roadmapai:roadmapai@localhost:5433/roadmapai"
PORT=3001
NODE_ENV=development

# Gemini 3.1 Flash Lite - get key at https://aistudio.google.com/apikey
# Without this, POST /api/chat returns 503 with clear message; friend can add later, no code change needed
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# CORS - comma-separated or * to allow all localhost. Default allows any localhost:*/127.0.0.1:* plus listed
CORS_ORIGIN="http://localhost:5173"
