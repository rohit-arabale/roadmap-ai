generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  userId           String   @id @map("user_id")
  id               String
  name             String
  interests        Json
  skillLevel       String   @map("skill_level")
  knownSkills      Json     @map("known_skills")
  completedCourses Json     @map("completed_courses")
  goal             String   @db.Text
  weeklyHours      Int      @map("weekly_hours")
  updatedAt        DateTime @map("updated_at")

  @@map("profiles")
}

model Path {
  id             String   @id
  userId         String   @map("user_id")
  goal           String   @db.Text
  profileId      String   @map("profile_id")
  nodes          Json
  milestones     Json
  estimatedWeeks Int      @map("estimated_weeks")
  createdAt      DateTime @map("created_at")

  @@index([userId])
  @@map("paths")
}

model Feedback {
  userId String @map("user_id")
  itemId String @map("item_id")
  rating String

  @@id([userId, itemId])
  @@map("feedback")
}

model SkillScore {
  userId         String   @map("user_id")
  topic          String
  score          Int
  totalQuestions Int      @map("total_questions")
  assessedAt     DateTime @map("assessed_at")

  @@id([userId, topic])
  @@map("skill_scores")
}
